---
import { getPublishedPosts } from '../utils/posts.ts';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getPublishedPosts()).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [latest, ...older] = posts;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
			}
			.latest {
				margin-bottom: 3rem;
			}
			.latest .date {
				margin: 0 0 0.5rem 0;
				color: rgb(var(--gray));
			}
			.latest h2 {
				margin: 0 0 0.75rem 0;
				line-height: 1.1;
			}
			.latest h2 a {
				text-decoration: none;
				color: rgb(var(--black));
			}
			.latest h2 a:hover {
				color: rgb(var(--accent));
			}
			.latest .excerpt {
				margin: 0 0 1rem 0;
				color: rgb(var(--gray-dark));
			}
			.read-more {
				font-weight: bold;
			}
			.older h3 {
				margin: 0 0 1rem 0;
				padding-bottom: 0.5rem;
				border-bottom: 1px solid rgb(var(--gray-light));
				color: rgb(var(--gray));
				font-size: 1rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.older ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.older li {
				margin-bottom: 0.75rem;
			}
			.older li a {
				text-decoration: none;
				color: rgb(var(--black));
			}
			.older li a:hover {
				color: rgb(var(--accent));
			}
			.older .list-date {
				display: inline-block;
				min-width: 8.5rem;
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			{
				latest && (
					<section class="latest">
						<p class="date">
							<FormattedDate date={latest.data.pubDate} />
						</p>
						<h2>
							<a href={`/blog/${latest.id}/`}>{latest.data.title}</a>
						</h2>
						<p class="excerpt">{latest.data.description}</p>
						<a class="read-more" href={`/blog/${latest.id}/`}>
							Read the full post &rarr;
						</a>
					</section>
				)
			}

			{
				older.length > 0 && (
					<section class="older">
						<h3>Earlier posts</h3>
						<ul>
							{older.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<span class="list-date">
											<FormattedDate date={post.data.pubDate} />
										</span>
										<span class="list-title">{post.data.title}</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>
