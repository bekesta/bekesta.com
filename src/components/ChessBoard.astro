---
// ChessBoard.astro — shows a single static chess position from a FEN,
// no interaction, using @mliebelt/pgn-viewer's pgnBoard (GPL-3.0).
//
// Usage:
//   import ChessBoard from '../components/ChessBoard.astro';
//   <ChessBoard fen="rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1" />

interface Props {
  /** Position in FEN. Defaults to the standard starting position. */
  fen?: string;
  /** Board orientation. Defaults to white. */
  orientation?: 'white' | 'black';
  /** Board width in CSS units (e.g. "320px"). Optional. */
  boardSize?: string;
  players?: string;
}

const {
  fen = 'rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1',
  orientation = 'white',
  boardSize,
  players,
} = Astro.props;

const id = `pgnb-${Math.random().toString(36).slice(2, 10)}`;
---

<figure class="pgnv-static-figure">
	 <div
	   id={id}
	   class="pgnv-static-board js-chess-board"
	   data-fen={fen}
	   data-orientation={orientation}
	   data-board-size={boardSize}
	 >
	 </div>
	 {players && <figcaption class="pgnv-players">{players}</figcaption>}
</figure>

<script>
  import { pgnBoard } from '@mliebelt/pgn-viewer';

  document.querySelectorAll<HTMLElement>('.js-chess-board').forEach((el) => {
    if (el.dataset.initialised) return;
    el.dataset.initialised = 'true';

    const boardSize = el.dataset.boardSize;
    pgnBoard(el.id, {
      position: el.dataset.fen ?? 'start',
      orientation: (el.dataset.orientation as 'white' | 'black') ?? 'white',
      theme: 'blue',
      pieceStyle: 'merida',
      ...(boardSize ? { boardSize } : {}),
	 coords: false,
	 ...(boardSize ? { boardSize } : {}),
    });
  });
</script>

<style>
	 .pgnv-static-figure {
		  margin: 1.5rem 0;
	 }	
     .pgnv-players {
	   margin-top: 0.5rem;
	   text-align: center;
       font-size: 0.9rem;
       color: rgb(var(--gray));
     }
	 .pgnv-static-board {
		  margin: 1.5rem auto;
	 }
</style>

<style is:global>
  .pgnv-static-board coords {
	 display: none !important;
}
</style>
